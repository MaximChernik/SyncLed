<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SyncLed.Avalonia.App"
             RequestedThemeVariant="Dark">
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="avares://SyncLed/Assets/app.ico"
                ToolTipText="SyncLed"
                IsVisible="True">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Открыть" Click="OnTrayOpenClick" />
            <NativeMenuItem Header="Старт / Стоп" Click="OnTraySyncClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Выход" Click="OnTrayExitClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SyncLed/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
