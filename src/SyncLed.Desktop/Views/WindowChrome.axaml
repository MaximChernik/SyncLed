<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SyncLed.Avalonia.Views.WindowChrome"
             x:Name="Root"
             Height="40"
             MinHeight="40"
             Background="Transparent">

  <UserControl.Styles>
    <!-- Кнопки окна: те же поверхности и радиусы, что у остальных контролов. -->
    <Style Selector="Button.winCaption">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.winCaption /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.1"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.winCaption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D2432"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="Button.winCaption:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#262F41"/>
    </Style>
    <Style Selector="Button.winClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E81123"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.winClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C50F1F"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Глифы кнопок: цвет следует состоянию кнопки. -->
    <Style Selector="Button.winCaption Path">
      <Setter Property="Stroke" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Stroke" Duration="0:0:0.1"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.winCaption:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="Button.winClose:pointerover Path">
      <Setter Property="Stroke" Value="#FFFFFF"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#0B0E15"
          BorderBrush="{StaticResource Brush.BorderSoft}"
          BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto">

      <!-- знак приложения + заголовок -->
      <StackPanel Orientation="Horizontal"
                  Spacing="9"
                  Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  PointerPressed="OnDragAreaPointerPressed">
        <Border Width="20" Height="20"
                CornerRadius="6"
                Background="#1B2334"
                BorderBrush="#4D5B8C"
                BorderThickness="1"
                VerticalAlignment="Center">
          <!-- Векторный знак 24×24: симметричен по обеим осям, Viewbox
               масштабирует его целиком — форма не «плывёт» на любом DPI. -->
          <Viewbox Width="12.5" Height="12.5" Stretch="Uniform">
            <Panel Width="24" Height="24">
              <Path Data="M6,3.5 H18 A2.5,2.5 0 0 1 20.5,6 V13 A2.5,2.5 0 0 1 18,15.5 H6 A2.5,2.5 0 0 1 3.5,13 V6 A2.5,2.5 0 0 1 6,3.5 Z"
                    Stroke="{StaticResource Brush.AccentGradient}"
                    StrokeThickness="2"/>
              <Path Data="M12,17 V18.5 M8,20.5 H16"
                    Stroke="#9CA6C4"
                    StrokeThickness="2"
                    StrokeLineCap="Round"/>
            </Panel>
          </Viewbox>
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextSoft}"
                   VerticalAlignment="Center"
                   Margin="2,0,0,0"/>
      </StackPanel>

      <!-- перетаскивание / двойной щелчок -->
      <Border x:Name="DragArea"
              Grid.Column="1"
              Background="Transparent"
              PointerPressed="OnDragAreaPointerPressed"/>

      <!-- кнопки окна (отступ от края — рядом работает зона изменения размера) -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
        <Button Classes="winCaption"
                IsVisible="{Binding ShowMinimize, ElementName=Root}"
                Click="OnMinimizeClick"
                ToolTip.Tip="Свернуть">
          <Path Data="M1,5.5 H10"
                Width="11" Height="11"
                StrokeThickness="1.2"
                StrokeLineCap="Round"/>
        </Button>
        <Button Classes="winCaption"
                IsVisible="{Binding ShowMaximize, ElementName=Root}"
                Click="OnMaximizeClick"
                ToolTip.Tip="Развернуть">
          <Panel Width="11" Height="11">
            <Path x:Name="MaxGlyph"
                  Data="M1.5,1.5 H9.5 V9.5 H1.5 Z"
                  StrokeThickness="1.2"/>
            <Path x:Name="RestoreGlyph"
                  Data="M4,1.5 H9.5 V7 H4 Z M1.5,3.5 V9.5 H7.5"
                  StrokeThickness="1.2"
                  IsVisible="False"/>
          </Panel>
        </Button>
        <Button Classes="winCaption winClose"
                Click="OnCloseClick"
                ToolTip.Tip="Закрыть">
          <Path Data="M1.5,1.5 L9.5,9.5 M9.5,1.5 L1.5,9.5"
                Width="11" Height="11"
                StrokeThickness="1.2"
                StrokeLineCap="Round"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
