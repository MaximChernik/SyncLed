<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyncLed.Avalonia.ViewModels"
        xmlns:views="using:SyncLed.Avalonia.Views"
        x:Class="SyncLed.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SyncLed"
        Width="1360"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        Background="#090B10"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Accent2}"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="TextBlock.brandSub">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style Selector="TextBlock.footerNote">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.navIcon">
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.nav.accent TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.statusPill">
      <Setter Property="Background" Value="#131926"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.statusPill Border.dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.statusPill.sync Border.dot">
      <Setter Property="Background" Value="{StaticResource Brush.Good}"/>
    </Style>

    <Style Selector="TextBlock.placeholderTitle">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.placeholderText">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="40,*">

    <!-- ── заголовочная панель окна (перетаскивание, свернуть/развернуть/закрыть) ── -->
    <views:WindowChrome Grid.Row="0" Title="SyncLed"/>

    <Grid Grid.Row="1" ColumnDefinitions="218,*">

    <!-- ── лёгкий анимированный фон (тёмный фиолетово-циановый градиент) ────
         Позади непрозрачной боковой панели и карточек; ввод не перехватывает. -->
    <views:AnimatedGradientBackground Grid.Column="0" Grid.ColumnSpan="2" ZIndex="-1"/>

    <!-- ── боковая панель ─────────────────────────────────────────────── -->
    <Border Grid.Column="0"
            Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.BorderSoft}"
            BorderThickness="0,0,1,0"
            Padding="16,20,16,12">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="42,10,*" Height="42">
          <Border Grid.Column="0"
                  Width="42" Height="42"
                  CornerRadius="12"
                  Background="#1B2334"
                  BorderBrush="#4D5B8C"
                  BorderThickness="1"
                  ToolTip.Tip="SyncLed">
            <!-- Тот же векторный знак, что и в WindowChrome: 24×24, центрированный
                 через Viewbox — симметричная форма на любом масштабе DPI. -->
            <Viewbox Width="26" Height="26" Stretch="Uniform">
              <Panel Width="24" Height="24">
                <Path Data="M6,3.5 H18 A2.5,2.5 0 0 1 20.5,6 V13 A2.5,2.5 0 0 1 18,15.5 H6 A2.5,2.5 0 0 1 3.5,13 V6 A2.5,2.5 0 0 1 6,3.5 Z"
                      Stroke="{StaticResource Brush.AccentGradient}"
                      StrokeThickness="2"/>
                <Path Data="M12,17 V18.5 M8,20.5 H16"
                      Stroke="#9CA6C4"
                      StrokeThickness="2"
                      StrokeLineCap="Round"/>
              </Panel>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,0,2">
            <TextBlock Text="SyncLed" Classes="brand"/>
            <TextBlock Text="AMBIENT LIGHTING" Classes="brandSub"/>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="ПРИЛОЖЕНИЕ" Classes="caption" Margin="4,24,0,10"/>

        <StackPanel Grid.Row="2" Spacing="4">
          <Button Classes="nav" Classes.accent="{Binding IsDevicesPage}"
                  Width="184" Height="42" HorizontalAlignment="Stretch"
                  Tag="devices" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="▦" Classes="navIcon"/>
              <TextBlock Text="Устройства" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsGroupsPage}"
                  Width="184" Height="42" HorizontalAlignment="Stretch"
                  Tag="groups" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="⊞" Classes="navIcon"/>
              <TextBlock Text="Группы" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsDiagnosticsPage}"
                  Width="184" Height="42" HorizontalAlignment="Stretch"
                  Tag="diagnostics" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="◧" Classes="navIcon"/>
              <TextBlock Text="Диагностика" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsSettingsPage}"
                  Width="184" Height="42" HorizontalAlignment="Stretch"
                  Tag="settings" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="⚙" Classes="navIcon"/>
              <TextBlock Text="Настройки" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsLogPage}"
                  Width="184" Height="42" HorizontalAlignment="Stretch"
                  Tag="log" Click="OnNavClick">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="≡" Classes="navIcon"/>
              <TextBlock Text="Журнал" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="СВЕТ · ЦВЕТ · АТМОСФЕРА"
                   Classes="footerNote"
                   Margin="0,12,0,0"/>
      </Grid>
    </Border>

    <!-- ── основная область ───────────────────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,24,14">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ" Classes="eyebrow"/>
          <TextBlock x:Name="PageTitle" Text="Устройства" Classes="h1" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding Subtitle}" Classes="subtitle"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="statusPill" Classes.sync="{Binding IsSyncing}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="dot"/>
              <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button Classes="ghost"
                  Content="Обновить"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Поиск устройств"/>
          <Button Classes="primary"
                  Content="{Binding SyncButtonText}"
                  Command="{Binding SyncCommand}"
                  MinWidth="122"
                  ToolTip.Tip="Запуск и остановка синхронизации"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">

        <!-- Устройства -->
        <!-- Устройства: прокрутка от шапки до низа клиентской области;
             нижний отступ задаёт Margin контента, поэтому он гарантированно
             попадает в extent и последний ряд не обрезается. -->
        <Grid IsVisible="{Binding IsDevicesPage}">
          <ScrollViewer x:Name="DevicesScroller"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top">
            <ItemsControl x:Name="DevicesList"
                          ItemsSource="{Binding Devices}"
                          Margin="28,2,28,20"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <views:ResponsiveCardPanel MinCardWidth="424"
                                             ColumnSpacing="18"
                                             RowSpacing="18"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <views:DeviceCardView/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border x:Name="EmptyState"
                  Classes="panel"
                  IsVisible="False"
                  Margin="28,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Padding="24">
            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Ленты не найдены" Classes="placeholderTitle"/>
              <TextBlock Text="Подключите USB-ленту и нажмите «Обновить»." Classes="placeholderText"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Группы -->
        <views:GroupsView IsVisible="{Binding IsGroupsPage}"/>

        <!-- Диагностика -->
        <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsPage}"/>

        <!-- Настройки -->
        <views:SettingsView IsVisible="{Binding IsSettingsPage}"/>

        <!-- Журнал -->
        <views:LogView IsVisible="{Binding IsLogPage}"/>

      </Grid>
    </Grid>
    </Grid>

    <!-- ── зоны изменения размера окна (SystemDecorations="None") ─────────── -->
    <Border Grid.Row="0" Grid.RowSpan="2" Width="5"
            HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Background="Transparent" Cursor="SizeWestEast"
            ZIndex="900" views:WindowChrome.Edge="West"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="5"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Background="Transparent" Cursor="SizeWestEast"
            ZIndex="900" views:WindowChrome.Edge="East"/>
    <Border Grid.Row="1" Height="5"
            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeNorthSouth"
            ZIndex="900" views:WindowChrome.Edge="South"/>
    <Border Grid.Row="0" Height="5" Margin="140,0,140,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeNorthSouth"
            ZIndex="900" views:WindowChrome.Edge="North"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="NorthWest"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="NorthEast"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="SouthWest"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="SouthEast"/>
  </Grid>
</Window>
