<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyncLed.Avalonia.ViewModels"
        xmlns:views="using:SyncLed.Avalonia.Views"
        x:Class="SyncLed.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SyncLed"
        Width="1360"
        Height="860"
        MinWidth="900"
        MinHeight="720"
        Background="#090B10"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Accent2}"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="TextBlock.brandSub">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
    </Style>
    <Style Selector="TextBlock.footerNote">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.navIcon">
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.nav.accent TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.statusPill">
      <Setter Property="Background" Value="#131926"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.statusPill Border.dot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.statusPill.sync Border.dot">
      <Setter Property="Background" Value="{StaticResource Brush.Good}"/>
    </Style>

    <Style Selector="TextBlock.placeholderTitle">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.placeholderText">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Быстрые пресеты в шапке страницы «Устройства». -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#151B29"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="13,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D2534"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="#21314B"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Всплывающие уведомления в правом нижнем углу. -->
    <Style Selector="Border.toast">
      <Setter Property="Background" Value="#161D2C"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="MaxWidth" Value="430"/>
      <Setter Property="BoxShadow" Value="0 8 24 0 #66000000"/>
    </Style>
    <Style Selector="Border.toast TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.toast.success">
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Good}"/>
    </Style>
    <Style Selector="Border.toast.success TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>
    <Style Selector="Border.toast.error">
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Bad}"/>
    </Style>
    <Style Selector="Border.toast.error TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    </Style>

    <!-- Компактная боковая панель (узкое окно): колонка иконок без подписей. -->
    <Style Selector="Border.sidebar.compact">
      <Setter Property="Padding" Value="13,20,13,12"/>
    </Style>
    <Style Selector="Border.sidebar.compact Button.nav">
      <Setter Property="Width" Value="44"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="MaxWidth" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.sidebar.compact TextBlock.navLabel">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.sidebar.compact Grid.brandBlock">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.sidebar.compact TextBlock.navCaption">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.sidebar.compact TextBlock.footerNote">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="40,*">

    <!-- ── заголовочная панель окна (перетаскивание, свернуть/развернуть/закрыть) ── -->
    <views:WindowChrome Grid.Row="0" Title="SyncLed"/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

    <!-- ── лёгкий анимированный фон (тёмный фиолетово-циановый градиент) ────
         Позади непрозрачной боковой панели и карточек; ввод не перехватывает. -->
    <views:AnimatedGradientBackground Grid.Column="0" Grid.ColumnSpan="2" ZIndex="-1"/>

    <!-- ── боковая панель ─────────────────────────────────────────────── -->
    <!-- Ширина привязана к SidebarWidth: при узком окне панель сворачивается
         в колонку иконок (класс compact скрывает подписи). -->
    <Border Grid.Column="0"
            Classes="sidebar"
            Classes.compact="{Binding IsSidebarCompact}"
            Width="{Binding SidebarWidth}"
            Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.BorderSoft}"
            BorderThickness="0,0,1,0"
            Padding="16,20,16,12">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" Classes="brandBlock" ColumnDefinitions="42,10,*" Height="42">
          <Border Grid.Column="0"
                  Width="42" Height="42"
                  CornerRadius="12"
                  Background="#1B2334"
                  BorderBrush="#4D5B8C"
                  BorderThickness="1"
                  ToolTip.Tip="SyncLed">
            <!-- Тот же векторный знак, что и в WindowChrome: 24×24, центрированный
                 через Viewbox — симметричная форма на любом масштабе DPI. -->
            <Viewbox Width="26" Height="26" Stretch="Uniform">
              <Panel Width="24" Height="24">
                <Path Data="M6,3.5 H18 A2.5,2.5 0 0 1 20.5,6 V13 A2.5,2.5 0 0 1 18,15.5 H6 A2.5,2.5 0 0 1 3.5,13 V6 A2.5,2.5 0 0 1 6,3.5 Z"
                      Stroke="{StaticResource Brush.AccentGradient}"
                      StrokeThickness="2"/>
                <Path Data="M12,17 V18.5 M8,20.5 H16"
                      Stroke="#9CA6C4"
                      StrokeThickness="2"
                      StrokeLineCap="Round"/>
              </Panel>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,0,2">
            <TextBlock Text="SyncLed" Classes="brand"/>
            <TextBlock Text="AMBIENT LIGHTING" Classes="brandSub"/>
          </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="ПРИЛОЖЕНИЕ" Classes="caption navCaption" Margin="4,24,0,10"/>

        <StackPanel Grid.Row="2" Spacing="4">
          <Button Classes="nav" Classes.accent="{Binding IsDevicesPage}"
                  Height="42" HorizontalAlignment="Stretch"
                  Tag="devices" Click="OnNavClick" ToolTip.Tip="Устройства">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="▦" Classes="navIcon"/>
              <TextBlock Text="Устройства" Classes="navLabel" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsGroupsPage}"
                  Height="42" HorizontalAlignment="Stretch"
                  Tag="groups" Click="OnNavClick" ToolTip.Tip="Группы">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="⊞" Classes="navIcon"/>
              <TextBlock Text="Группы" Classes="navLabel" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsDiagnosticsPage}"
                  Height="42" HorizontalAlignment="Stretch"
                  Tag="diagnostics" Click="OnNavClick" ToolTip.Tip="Диагностика">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="◧" Classes="navIcon"/>
              <TextBlock Text="Диагностика" Classes="navLabel" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsSettingsPage}"
                  Height="42" HorizontalAlignment="Stretch"
                  Tag="settings" Click="OnNavClick" ToolTip.Tip="Настройки">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="⚙" Classes="navIcon"/>
              <TextBlock Text="Настройки" Classes="navLabel" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.accent="{Binding IsLogPage}"
                  Height="42" HorizontalAlignment="Stretch"
                  Tag="log" Click="OnNavClick" ToolTip.Tip="Журнал">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="≡" Classes="navIcon"/>
              <TextBlock Text="Журнал" Classes="navLabel" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="3">
          <TextBlock Text="СВЕТ · ЦВЕТ · АТМОСФЕРА"
                     Classes="footerNote"
                     Margin="0,12,0,0"/>
          <TextBlock Text="{Binding VersionLabel}" Classes="footerNote"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── основная область ───────────────────────────────────────────── -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,24,14">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="ПАНЕЛЬ УПРАВЛЕНИЯ" Classes="eyebrow"/>
          <TextBlock x:Name="PageTitle" Text="Устройства" Classes="h1" Margin="0,2,0,0"/>
          <TextBlock Text="{Binding Subtitle}" Classes="subtitle"/>

          <!-- Быстрые пресеты: применение общих настроек в один клик. -->
          <ItemsControl ItemsSource="{Binding Presets}"
                        IsVisible="{Binding IsDevicesPage}"
                        Margin="0,11,0,0"
                        VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="chip" Classes.active="{Binding IsActive}"
                        Click="OnPresetChipClick"
                        ToolTip.Tip="Применить этот пресет к общим настройкам">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✓"
                               IsVisible="{Binding IsActive}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="statusPill" Classes.sync="{Binding IsSyncing}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="dot"/>
              <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding RefreshStatusText}"
                     Foreground="{StaticResource Brush.Muted}"
                     FontSize="12"
                     VerticalAlignment="Center"/>
          <Button Classes="ghost"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Поиск устройств">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <!-- Кольцевой индикатор поиска: вращается, пока идёт обновление.
                   Avalonia 11.2 не поставляет ProgressRing — рисуем дугу сами. -->
              <Path x:Name="SearchSpinner"
                    Width="13" Height="13"
                    Stretch="Uniform"
                    IsVisible="{Binding IsRefreshing}"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="50%,50%"
                    Data="M6.5,1 A5.5,5.5 0 1 1 1.74,3.75"
                    Stroke="{StaticResource Brush.Accent2}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"/>
              <TextBlock Text="Обновить" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="primary"
                  Content="{Binding SyncButtonText}"
                  Command="{Binding SyncCommand}"
                  MinWidth="122"
                  ToolTip.Tip="Запуск и остановка синхронизации"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">

        <!-- Устройства -->
        <!-- Устройства: прокрутка от шапки до низа клиентской области;
             нижний отступ задаёт Margin контента, поэтому он гарантированно
             попадает в extent и последний ряд не обрезается. -->
        <Grid x:Name="PageDevices" IsVisible="{Binding IsDevicesPage}">
          <ScrollViewer x:Name="DevicesScroller"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Top">
            <ItemsControl x:Name="DevicesList"
                          ItemsSource="{Binding Devices}"
                          Margin="28,2,28,20"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <views:ResponsiveCardPanel MinCardWidth="424"
                                             ColumnSpacing="18"
                                             RowSpacing="18"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <views:DeviceCardView/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border x:Name="EmptyState"
                  Classes="panel"
                  IsVisible="False"
                  Margin="28,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Padding="24">
            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Ленты не найдены" Classes="placeholderTitle"/>
              <TextBlock Text="Подключите USB-ленту и нажмите «Обновить»." Classes="placeholderText"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Группы -->
        <views:GroupsView x:Name="PageGroups" IsVisible="{Binding IsGroupsPage}"/>

        <!-- Диагностика -->
        <views:DiagnosticsView x:Name="PageDiagnostics" IsVisible="{Binding IsDiagnosticsPage}"/>

        <!-- Настройки -->
        <views:SettingsView x:Name="PageSettings" IsVisible="{Binding IsSettingsPage}"/>

        <!-- Журнал -->
        <views:LogView x:Name="PageLog" IsVisible="{Binding IsLogPage}"/>

      </Grid>
    </Grid>

    <!-- ── всплывающие уведомления (правый нижний угол контентной области) ── -->
    <ItemsControl Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,26,26"
                  ZIndex="950"
                  IsHitTestVisible="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="toast"
                  Classes.success="{Binding IsSuccess}"
                  Classes.error="{Binding IsError}">
            <TextBlock Text="{Binding Message}"/>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>

    <!-- ── зоны изменения размера окна (SystemDecorations="None") ─────────── -->
    <Border Grid.Row="0" Grid.RowSpan="2" Width="5"
            HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Background="Transparent" Cursor="SizeWestEast"
            ZIndex="900" views:WindowChrome.Edge="West"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="5"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Background="Transparent" Cursor="SizeWestEast"
            ZIndex="900" views:WindowChrome.Edge="East"/>
    <Border Grid.Row="1" Height="5"
            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeNorthSouth"
            ZIndex="900" views:WindowChrome.Edge="South"/>
    <Border Grid.Row="0" Height="5" Margin="140,0,140,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeNorthSouth"
            ZIndex="900" views:WindowChrome.Edge="North"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="NorthWest"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="NorthEast"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="SouthWest"/>
    <Border Grid.Row="0" Grid.RowSpan="2" Width="9" Height="9"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="SizeAll"
            ZIndex="901" views:WindowChrome.Edge="SouthEast"/>
  </Grid>
</Window>
