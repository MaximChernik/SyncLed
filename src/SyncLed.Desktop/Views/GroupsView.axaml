<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SyncLed.Avalonia.Views.GroupsView">
  <DockPanel Margin="24">

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock DockPanel.Dock="Left"
                 Text="Группы устройств"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource Brush.Text}"
                 VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <TextBox x:Name="NewNameBox"
                 Width="200"
                 Watermark="Название новой группы"
                 VerticalAlignment="Center" />
        <Button Classes="primary"
                Content="Добавить"
                VerticalAlignment="Center"
                Click="OnAddGroupClick" />
        <Button Classes="ghost"
                Content="Переименовать"
                VerticalAlignment="Center"
                Click="OnRenameGroupClick" />
        <Button Classes="ghost"
                Content="Удалить"
                VerticalAlignment="Center"
                Click="OnDeleteGroupClick" />
      </StackPanel>
    </DockPanel>

    <Grid ColumnDefinitions="280,*">

      <Border Classes="panel" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="Список групп"
                     Foreground="{StaticResource Brush.Muted}"
                     FontSize="12"
                     Margin="6,2,6,8" />
          <ListBox x:Name="GroupsList"
                   SelectionChanged="OnGroupSelectionChanged"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource Brush.TextSoft}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="16,0,0,0" Padding="24">
        <Grid>
          <TextBlock x:Name="PlaceholderText"
                     Text="Выберите группу слева или создайте новую"
                     Foreground="{StaticResource Brush.Muted}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

          <ScrollViewer x:Name="EditorPanel" IsVisible="False">
            <StackPanel Spacing="6">

              <TextBlock Text="Название"
                         Foreground="{StaticResource Brush.Muted}"
                         FontSize="12"
                         Margin="0,0,0,4" />
              <TextBox x:Name="NameBox" Width="320" HorizontalAlignment="Left" />

              <TextBlock Text="Режим группы"
                         Foreground="{StaticResource Brush.Muted}"
                         FontSize="12"
                         Margin="0,12,0,4" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ModeSyncBtn"
                        Classes="ghost"
                        Content="Синхронизация"
                        Click="OnModeSyncClick" />
                <Button x:Name="ModeColorBtn"
                        Classes="ghost"
                        Content="Свой цвет"
                        Click="OnModeColorClick" />
                <Button x:Name="ModeOffBtn"
                        Classes="ghost"
                        Content="Выключено"
                        Click="OnModeOffClick" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <TextBox x:Name="ColorBox"
                          Width="120"
                          Watermark="#RRGGBB"
                          VerticalAlignment="Center" />
                <Button Classes="ghost"
                        Content="Применить цвет"
                        VerticalAlignment="Center"
                        Click="OnApplyColorClick" />
              </StackPanel>
              <TextBlock Text="Цвет используется лентами группы в режиме «Свой цвет»."
                         Foreground="{StaticResource Brush.Muted}"
                         FontSize="12"
                         TextWrapping="Wrap" />

              <Border Height="1"
                      Background="{StaticResource Brush.BorderSoft}"
                      Margin="0,14" />

              <CheckBox x:Name="SplitCheck"
                        Content="Делить периметр монитора между лентами группы"
                        Click="OnSplitPerimeterClick" />
              <TextBlock Text="Без деления каждая лента группы повторяет весь периметр."
                         Foreground="{StaticResource Brush.Muted}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,0,0,6" />

              <Border Height="1"
                      Background="{StaticResource Brush.BorderSoft}"
                      Margin="0,8" />

              <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Left"
                           Text="Ленты в группе"
                           Foreground="{StaticResource Brush.Muted}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="MembersCountText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource Brush.TextSoft}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </DockPanel>
              <Border Classes="inset" Padding="14,10" Margin="0,4,0,0">
                <StackPanel x:Name="MembersPanel" Spacing="2" />
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

    </Grid>
  </DockPanel>
</UserControl>
