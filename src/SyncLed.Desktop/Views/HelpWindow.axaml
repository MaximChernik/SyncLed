<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SyncLed.Avalonia.Views"
        x:Class="SyncLed.Avalonia.Views.HelpWindow"
        Title="Что за что отвечает"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="560"
        SystemDecorations="None"
        CanResize="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg}"
        KeyDown="OnWindowKeyDown">
  <Grid RowDefinitions="40,Auto,*,Auto">
    <views:WindowChrome Grid.Row="0"
                        Title="Что за что отвечает"
                        ShowMinimize="False"
                        ShowMaximize="False"/>

    <StackPanel Grid.Row="1" Margin="28,18,28,8" Spacing="5">
      <TextBlock Text="ЧТО ЗА ЧТО ОТВЕЧАЕТ"
                 FontSize="10.5"
                 FontWeight="Bold"
                 LetterSpacing="0.9"
                 Foreground="{StaticResource Brush.Accent2}"/>
      <TextBlock Text="Краткое описание параметров. Изменения применяются сразу и сохраняются автоматически."
                 FontSize="12.5"
                 Foreground="{StaticResource Brush.Muted}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="2"
            Classes="inset"
            Margin="28,10,28,12"
            Padding="22,16,14,12">
      <ScrollViewer x:Name="HelpScroller"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="HelpStack" Margin="0,0,4,12" Spacing="0"/>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="28,0,28,24">
      <TextBlock Grid.Column="0"
                 Text="Колёсико мыши и клавиши ↑ ↓ PgUp PgDn прокручивают список."
                 FontSize="11"
                 Foreground="{StaticResource Brush.Muted}"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="1"
              Classes="primary"
              Content="Понятно"
              MinWidth="118"
              Click="OnCloseClick"/>
    </Grid>
  </Grid>
</Window>
